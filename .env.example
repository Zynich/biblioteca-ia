# ---------------------------------------------------------------------------
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env real (já está no .gitignore).
# ---------------------------------------------------------------------------

# ----- books_api (Questão 1) -----
BOOKS_DATABASE_URL=sqlite:////app/data/books.db

# ----- chatbot (Questão 2) -----
# Provedor do LLM: openai (padrão do enunciado) | gemini (plano gratuito) | ollama (local, sem chave)
LLM_PROVIDER=openai

OPENAI_API_KEY=
# Nome do modelo configurável: o enunciado cita GPT-4, mas os nomes de modelo
# da OpenAI mudam com frequência — mantenha isso como env var.
OPENAI_MODEL=gpt-4o-mini

# Gemini: chave gratuita em https://aistudio.google.com/apikey (só conta Google, sem cartão)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama: LLM local, sem chave. Suba com `make up-local` e baixe o modelo com `make pull-model`.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# LangSmith (observabilidade das chains)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=biblioteca-ia-chatbot

# ----- semantic_search (Questão 3) -----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=/app/index/articles.faiss
FAISS_METADATA_PATH=/app/index/articles_metadata.json
